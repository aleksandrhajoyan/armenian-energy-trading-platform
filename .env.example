# =============================================================================
# AI Energy Trading Platform — environment placeholder template
# Copy to `.env` locally. Never commit real secrets.
# Values below are non-functional placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# CURRENTLY IMPLEMENTED
# AppSettings keys are read by src/energy_trading/shared/config/settings.py.
# DatabaseSettings keys are read only when that object is loaded explicitly
# (src/energy_trading/shared/config/database.py). RedisSettings keys are read
# only when that object is loaded explicitly
# (src/energy_trading/shared/config/redis.py). QdrantSettings keys are read
# only when that object is loaded explicitly
# (src/energy_trading/shared/config/qdrant.py). OpenAISettings keys are read
# only when that object is loaded explicitly
# (src/energy_trading/shared/config/openai.py). RegulatoryIntelligenceRuntimeSettings
# keys are read only when that object is loaded explicitly
# (src/energy_trading/shared/config/regulatory_intelligence.py). They are NOT
# required for process health or create_app().
# Safe local AppSettings defaults exist; the process can start with no secrets
# and no .env.
# -----------------------------------------------------------------------------
APP_NAME=AI Energy Trading Platform
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- PostgreSQL / TimescaleDB (DatabaseSettings, Alembic, Compose postgres profile) ---
# Not required for process health or create_app(). Compose interpolates these
# values into the on-demand timescaledb service. Do not start that service
# unless you need live persistence tests.
ENERGY_DB_HOST=127.0.0.1
# Host TCP port published on 127.0.0.1 only. Change locally if 5432 is already in use.
ENERGY_DB_PORT=5432
ENERGY_DB_DATABASE=energy_trading
ENERGY_DB_USERNAME=energy_trading
ENERGY_DB_PASSWORD=change-me
# Opt-in live pytest marker. Leave unset for the default offline suite.
# ENERGY_RUN_POSTGRES_INTEGRATION=1
ENERGY_DB_POOL_SIZE=5
ENERGY_DB_MAX_OVERFLOW=10
ENERGY_DB_POOL_TIMEOUT_SECONDS=30

# --- Redis cache (RedisSettings, Compose redis profile) ---
# Loaded only when RedisSettings / load_redis_settings() is invoked explicitly.
# Not required for process health or create_app(). Redis is optional/on-demand:
# docker compose --profile redis up -d redis
# Local Compose Redis is loopback-only and non-TLS (REDIS_SSL=false).
# The Compose redis profile requires a non-empty REDIS_PASSWORD in the
# untracked local `.env`. Keep this example blank. Never commit a real password.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=10
# Opt-in live pytest marker. Leave unset for the default offline suite.
# ENERGY_RUN_REDIS_INTEGRATION=1

# --- Qdrant HTTP client (QdrantSettings, Compose qdrant profile) ---
# Loaded only when QdrantSettings / load_qdrant_settings() is invoked explicitly.
# Not required for process health or create_app(). Qdrant is optional/on-demand:
# docker compose --profile qdrant up -d qdrant
# Local Compose Qdrant is loopback-only HTTP (QDRANT_HTTPS=false) on REST port
# 6333. Host-side tests use QDRANT_HOST=127.0.0.1. This is local
# development/test infrastructure. It is not the production Qdrant security
# architecture. Production requires appropriately secured networking/TLS.
# The Compose qdrant profile requires a non-empty QDRANT_API_KEY in the
# untracked local `.env`. Keep this example blank. Never commit a real key.
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=5
# Opt-in live pytest marker. Leave unset for the default offline suite.
# ENERGY_RUN_QDRANT_INTEGRATION=1

# --- OpenAI HTTP client (OpenAISettings, infrastructure factory) ---
# Loaded only when OpenAISettings / load_openai_settings() is invoked explicitly.
# Not required for process health, create_app(), or the default offline test
# suite. Keep this example blank. Never commit a real key. Model selection is
# not part of OpenAISettings.
ENERGY_OPENAI_API_KEY=

# --- Regulatory Intelligence runtime (RegulatoryIntelligenceRuntimeSettings) ---
# Loaded only when RegulatoryIntelligenceRuntimeSettings /
# load_regulatory_intelligence_runtime_settings() is invoked explicitly.
# Not required for process health or create_app(). These values are
# use-case-specific and are not part of OpenAISettings or QdrantSettings.
# Keep these example values blank. Blank placeholders are not production
# defaults and are not inferred from embedding models.
ENERGY_REGULATORY_QUERY_EMBEDDING_MODEL=
ENERGY_REGULATORY_CONSTRAINT_INFERENCE_MODEL=
ENERGY_REGULATORY_QDRANT_COLLECTION_NAME=
ENERGY_REGULATORY_QDRANT_VECTOR_SIZE=

# --- Document vector index runtime (DocumentVectorIndexRuntimeSettings) ---
# Loaded only when DocumentVectorIndexRuntimeSettings /
# load_document_vector_index_runtime_settings() is invoked explicitly.
# Not required for process health or create_app(). These values are
# indexing-runtime-specific and are not part of OpenAISettings,
# QdrantSettings, or RegulatoryIntelligenceRuntimeSettings.
# Keep these example values blank. Blank placeholders are not production
# defaults and are not inferred from embedding models.
ENERGY_DOCUMENT_INDEX_DOCUMENT_EMBEDDING_MODEL=
ENERGY_DOCUMENT_INDEX_QDRANT_COLLECTION_NAME=
ENERGY_DOCUMENT_INDEX_QDRANT_VECTOR_SIZE=

# --- n8n local service (Compose n8n profile only) ---
# Not consumed by the Python application, AppSettings, or create_app().
# n8n is optional/on-demand outer acquisition infrastructure:
# docker compose --profile n8n up -d n8n
# Local Compose n8n is loopback-only HTTP. Host publication uses
# N8N_HOST_PORT (defaults to 5678). The container always listens on 5678.
# If a developer sets N8N_HOST_PORT=5680, Compose publishes
# 127.0.0.1:5680 -> 5678. This is local development/test infrastructure.
# It is not the production n8n security architecture.
# The Compose n8n profile requires a non-empty N8N_ENCRYPTION_KEY in the
# untracked local `.env` or process environment. Use a strong random local
# value. Keep this example blank. Never commit a real key.
# The key protects n8n's own stored credentials/configuration. It is not an
# application API secret and is not a replacement for user authentication.
N8N_HOST_PORT=5678
N8N_ENCRYPTION_KEY=
# Opt-in live pytest marker. Leave unset for the default offline suite.
# ENERGY_RUN_N8N_INTEGRATION=1
ENERGY_RUN_N8N_INTEGRATION=0

# -----------------------------------------------------------------------------
# RESERVED / FUTURE
# Documented for later chunks. Ignored by the current settings models.
# Do not treat these as live configuration. Do not put real credentials here.
# -----------------------------------------------------------------------------

# --- Application (not yet consumed) ---
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
# Canonical market-local timezone is expected to be Asia/Yerevan; confirm before encoding market rules.
APP_TIMEZONE=Asia/Yerevan

# --- Qdrant (production collection name is not consumed yet) ---
QDRANT_COLLECTION_REGULATORY=regulatory_docs

# --- LLM provider (provider identity is configuration, not application code) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# --- External APIs (identifiers only; no vendor lock-in in this template) ---
# Populate per adapter when a source is actually integrated. Do not hardcode in source.
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=30

# --- Logging / observability ---
LOG_FORMAT=json
LOG_CORRELATION_HEADER=X-Correlation-ID
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=energy-trading
