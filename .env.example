# =============================================================================
# AI Energy Trading Platform — environment placeholder template
# Copy to `.env` locally. Never commit real secrets.
# Values below are non-functional placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# CURRENTLY IMPLEMENTED
# AppSettings keys are read by src/energy_trading/shared/config/settings.py.
# DatabaseSettings keys are read only when that object is loaded explicitly
# (src/energy_trading/shared/config/database.py). They are NOT required for
# process health or create_app().
# Safe local AppSettings defaults exist; the process can start with no secrets
# and no .env.
# -----------------------------------------------------------------------------
APP_NAME=AI Energy Trading Platform
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- PostgreSQL / TimescaleDB (DatabaseSettings; unused by health/create_app) ---
ENERGY_DB_HOST=localhost
ENERGY_DB_PORT=5432
ENERGY_DB_DATABASE=energy_trading
ENERGY_DB_USERNAME=energy_trading
ENERGY_DB_PASSWORD=change-me
ENERGY_DB_POOL_SIZE=5
ENERGY_DB_MAX_OVERFLOW=10
ENERGY_DB_POOL_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# RESERVED / FUTURE
# Documented for later chunks. Ignored by the current settings models.
# Do not treat these as live configuration. Do not put real credentials here.
# -----------------------------------------------------------------------------

# --- Application (not yet consumed) ---
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
# Canonical market-local timezone is expected to be Asia/Yerevan; confirm before encoding market rules.
APP_TIMEZONE=Asia/Yerevan

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_REGULATORY=regulatory_docs

# --- LLM provider (provider identity is configuration, not application code) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# --- External APIs (identifiers only; no vendor lock-in in this template) ---
# Populate per adapter when a source is actually integrated. Do not hardcode in source.
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=30

# --- Logging / observability ---
LOG_FORMAT=json
LOG_CORRELATION_HEADER=X-Correlation-ID
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=energy-trading
